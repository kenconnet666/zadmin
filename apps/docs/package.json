{
	"name": "@zadmin/docs",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"api:source:check": "node scripts/generate-component-api.mjs",
		"api:source:update": "node scripts/generate-component-api.mjs --write",
		"api:catalog:check": "node scripts/generate-catalog-manifest.mjs",
		"api:catalog:update": "node scripts/generate-catalog-manifest.mjs --write",
		"maturity:check": "node scripts/generate-maturity-matrix.mjs",
		"maturity:update": "node scripts/generate-maturity-matrix.mjs --write",
		"maturity:matrix": "node scripts/generate-maturity-matrix.mjs",
		"stability:check": "node scripts/check-stability-policy.mjs",
		"stability:update": "node scripts/check-stability-policy.mjs --write",
		"support:check": "node scripts/check-support-matrix.mjs",
		"support:update": "node scripts/check-support-matrix.mjs --write",
		"docs:versioned:check": "node scripts/check-versioned-docs.mjs",
		"docs:versioned:update": "node scripts/check-versioned-docs.mjs --write",
		"docs:versioned:emit": "node scripts/check-versioned-docs.mjs --emit",
		"audit:system": "node scripts/generate-component-api.mjs && node scripts/generate-catalog-manifest.mjs && node scripts/generate-maturity-matrix.mjs && node scripts/check-stability-policy.mjs && node scripts/check-support-matrix.mjs && node scripts/check-versioned-docs.mjs && node scripts/audit-system.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource/fira-mono": "catalog:",
		"@internationalized/date": "catalog:",
		"@lucide/svelte": "catalog:",
		"@zadmin/zui": "workspace:^",
		"shiki": "catalog:"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@axe-core/playwright": "catalog:",
		"@playwright/test": "catalog:",
		"prettier": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
