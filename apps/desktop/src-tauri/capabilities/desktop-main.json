{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop-main",
	"description": "Minimum production permissions for the ZAdmin Windows desktop main window.",
	"windows": ["main"],
	"platforms": ["windows"],
	"permissions": [
		"core:app:allow-identifier",
		"core:app:allow-name",
		"core:app:allow-tauri-version",
		"core:app:allow-version",
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"core:window:allow-close",
		"core:window:allow-current-monitor",
		"core:window:allow-is-focused",
		"core:window:allow-is-maximized",
		"core:window:allow-maximize",
		"core:window:allow-minimize",
		"core:window:allow-scale-factor",
		"core:window:allow-start-dragging",
		"core:window:allow-theme",
		"core:window:allow-toggle-maximize",
		"core:window:allow-unmaximize",
		"dialog:allow-message",
		"dialog:allow-open",
		"dialog:allow-save",
		"fs:allow-exists",
		"fs:allow-mkdir",
		"fs:allow-read-dir",
		"fs:allow-read-text-file",
		"fs:allow-remove",
		"fs:allow-stat",
		"fs:allow-unwatch",
		"fs:allow-watch",
		"fs:allow-write-text-file",
		{
			"identifier": "fs:scope",
			"allow": [
				{ "path": "$APPDATA/zadmin" },
				{ "path": "$APPDATA/zadmin/**/*" },
				{ "path": "$APPCACHE/zadmin" },
				{ "path": "$APPCACHE/zadmin/**/*" }
			]
		},
		"clipboard-manager:allow-clear",
		"clipboard-manager:allow-read-text",
		"clipboard-manager:allow-write-text",
		"notification:allow-is-permission-granted",
		"notification:allow-notify",
		"notification:allow-request-permission",
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://github.com/**" }, { "url": "https://v2.tauri.app/**" }]
		},
		"os:allow-arch",
		"os:allow-locale",
		"os:allow-platform",
		"os:allow-version",
		"process:allow-exit",
		"process:allow-restart",
		"store:allow-delete",
		"store:allow-get",
		"store:allow-get-store",
		"store:allow-has",
		"store:allow-load",
		"store:allow-save",
		"store:allow-set",
		"log:allow-log",
		"window-state:allow-filename",
		"window-state:allow-restore-state",
		"window-state:allow-save-window-state",
		"allow-desktop-channel-probe",
		"allow-desktop-error-probe",
		"allow-desktop-runtime-report"
	]
}
