{
	"name": "@zadmin/miniapp",
	"version": "0.1.0",
	"description": "Self-contained Svelte framework, components, compiler, runtime, and platform APIs for WeChat Mini Programs.",
	"type": "module",
	"sideEffects": [
		"**/*.svelte"
	],
	"main": "./dist/plugin/index.cjs",
	"types": "./src/index.ts",
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/plugin/index.cjs"
		},
		"./plugin": {
			"types": "./src/plugin/types.ts",
			"require": "./dist/plugin/index.cjs"
		},
		"./compiler": {
			"types": "./src/compiler/index.ts",
			"import": "./dist/compiler/index.js"
		},
		"./module": {
			"types": "./src/module/index.ts",
			"import": "./dist/module/index.js"
		},
		"./native": {
			"types": "./src/native/index.ts",
			"import": "./dist/native/index.js"
		},
		"./platform": {
			"types": "./src/platform/index.ts",
			"import": "./dist/platform/index.js"
		},
		"./renderer": {
			"types": "./src/renderer/index.ts",
			"import": "./dist/renderer/index.js"
		},
		"./runtime": {
			"types": "./src/runtime/index.ts",
			"import": "./dist/runtime/index.js"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./dist/testing/index.js"
		},
		"./vite": {
			"types": "./src/vite/index.ts",
			"import": "./dist/vite/index.js",
			"require": "./dist/plugin/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/plugin/index.cjs",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js",
				"require": "./dist/plugin/index.cjs"
			},
			"./plugin": {
				"types": "./dist/plugin/types.d.ts",
				"require": "./dist/plugin/index.cjs"
			},
			"./compiler": {
				"types": "./dist/compiler/index.d.ts",
				"import": "./dist/compiler/index.js"
			},
			"./module": {
				"types": "./dist/module/index.d.ts",
				"import": "./dist/module/index.js"
			},
			"./native": {
				"types": "./dist/native/index.d.ts",
				"import": "./dist/native/index.js"
			},
			"./platform": {
				"types": "./dist/platform/index.d.ts",
				"import": "./dist/platform/index.js"
			},
			"./renderer": {
				"types": "./dist/renderer/index.d.ts",
				"import": "./dist/renderer/index.js"
			},
			"./runtime": {
				"types": "./dist/runtime/index.d.ts",
				"import": "./dist/runtime/index.js"
			},
			"./testing": {
				"types": "./dist/testing/index.d.ts",
				"import": "./dist/testing/index.js"
			},
			"./vite": {
				"types": "./dist/vite/index.d.ts",
				"import": "./dist/vite/index.js",
				"require": "./dist/plugin/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && svelte-package --input src/components --output dist/components && node scripts/build-runtime.mjs",
		"benchmark": "pnpm build && node scripts/benchmark.mjs && pnpm -w exec prettier --write apps/docs/content/wechat-performance.json apps/docs/content/wechat-performance.md",
		"check": "tsc -p tsconfig.test.json --noEmit && svelte-check --tsconfig ./tsconfig.test.json",
		"report": "pnpm build && node scripts/generate-capability-report.mjs && pnpm -w exec prettier --write apps/docs/content/wechat-capability-report.json apps/docs/content/wechat-capability-report.md",
		"test": "pnpm build && vitest --run tests",
		"test:coverage": "pnpm build && vitest --run --coverage tests",
		"test:package": "node scripts/accept-package.mjs && pnpm -w exec prettier --write apps/docs/content/wechat-package-acceptance.json apps/docs/content/wechat-package-acceptance.md"
	},
	"keywords": [
		"svelte",
		"taro",
		"wechat",
		"mini-program",
		"custom-renderer"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/miniapp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/miniapp"
	},
	"peerDependencies": {
		"@tarojs/components": "4.2.1",
		"@tarojs/runtime": "4.2.1",
		"@tarojs/service": "4.2.1",
		"@tarojs/shared": "4.2.1",
		"@tarojs/taro": "4.2.1",
		"svelte": "5.56.10"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@tarojs/components": "catalog:wechat",
		"@tarojs/runtime": "catalog:wechat",
		"@tarojs/service": "catalog:wechat",
		"@tarojs/shared": "catalog:wechat",
		"@tarojs/taro": "catalog:wechat",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "0.28.2",
		"svelte": "https://pkg.svelte.dev/svelte/c/eb7532dd70fb11b36258347c44cf3910d244f987",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
