{
	"name": "@zadmin/zui-core",
	"version": "0.1.0",
	"description": "Platform-neutral themes, tokens, ICSS programs, and design contracts for ZUI.",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest --run tests",
		"test:coverage": "vitest --run --coverage tests"
	},
	"keywords": [
		"design-system",
		"typescript",
		"css-in-js",
		"taro",
		"svelte"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/zui-core",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/zui-core"
	},
	"dependencies": {
		"csstype": "catalog:"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
