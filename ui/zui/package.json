{
	"name": "@zadmin/zui",
	"version": "0.1.0",
	"description": "Type-safe Web runtime CSS and foundational Svelte components with class-only compiler optimization.",
	"author": "kenconnet666 <kenconnet@foxmail.com>",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"import": "./src/lib/index.ts"
		},
		"./core": {
			"types": "./src/lib/core.ts",
			"import": "./src/lib/core.ts"
		},
		"./compiler": {
			"types": "./src/lib/compiler/preprocess.ts",
			"import": "./src/lib/compiler/preprocess.ts"
		},
		"./code": {
			"types": "./src/lib/code.ts",
			"svelte": "./src/lib/code.ts",
			"import": "./src/lib/code.ts"
		},
		"./internal": {
			"types": "./src/lib/runtime/internal.ts",
			"svelte": "./src/lib/runtime/internal.ts",
			"import": "./src/lib/runtime/internal.ts"
		},
		"./metadata": {
			"types": "./src/lib/metadata.ts",
			"import": "./src/lib/metadata.ts"
		},
		"./runtime": {
			"types": "./src/lib/runtime.ts",
			"import": "./src/lib/runtime.ts"
		},
		"./testing": {
			"types": "./src/lib/testing/index.ts",
			"import": "./src/lib/testing/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js"
			},
			"./core": {
				"types": "./dist/core.d.ts",
				"import": "./dist/core.js"
			},
			"./compiler": {
				"types": "./dist/compiler/preprocess.d.ts",
				"import": "./dist/compiler/preprocess.js"
			},
			"./code": {
				"types": "./dist/code.d.ts",
				"svelte": "./dist/code.js",
				"import": "./dist/code.js"
			},
			"./internal": {
				"types": "./dist/runtime/internal.d.ts",
				"svelte": "./dist/runtime/internal.js",
				"import": "./dist/runtime/internal.js"
			},
			"./metadata": {
				"types": "./dist/metadata.d.ts",
				"import": "./dist/metadata.js"
			},
			"./runtime": {
				"types": "./dist/runtime.d.ts",
				"import": "./dist/runtime.js"
			},
			"./testing": {
				"types": "./dist/testing/index.d.ts",
				"import": "./dist/testing/index.js"
			}
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"build": "svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:bundle": "node scripts/check-bundle.mjs"
	},
	"keywords": [
		"css-in-js",
		"svelte",
		"sveltekit",
		"typescript",
		"ui"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/zui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/zui"
	},
	"bugs": {
		"url": "https://github.com/kenconnet666/zadmin/issues"
	},
	"dependencies": {
		"@floating-ui/dom": "catalog:",
		"@internationalized/date": "catalog:",
		"@standard-schema/spec": "catalog:",
		"@types/estree": "catalog:",
		"csstype": "catalog:",
		"estree-walker": "catalog:",
		"magic-string": "catalog:",
		"runed": "catalog:",
		"stylis": "catalog:",
		"tabbable": "catalog:"
	},
	"peerDependencies": {
		"shiki": "^4.4.3",
		"svelte": ">=5.56.0 <6"
	},
	"peerDependenciesMeta": {
		"shiki": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@types/stylis": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"fast-check": "catalog:",
		"playwright": "catalog:",
		"shiki": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
