{
	"name": "@zadmin/zui",
	"version": "0.1.0",
	"description": "Production Svelte 5 component system with typed ICSS, themes, accessible state, forms, overlays, and virtualized data surfaces.",
	"author": "kenconnet666 <kenconnet@foxmail.com>",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/entrypoints/index.ts",
			"svelte": "./src/entrypoints/index.ts",
			"default": "./src/entrypoints/index.ts"
		},
		"./*": {
			"types": "./src/entrypoints/*.ts",
			"svelte": "./src/entrypoints/*.ts",
			"default": "./src/entrypoints/*.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/entrypoints/index.d.ts",
				"svelte": "./dist/entrypoints/index.js",
				"default": "./dist/entrypoints/index.js"
			},
			"./*": {
				"types": "./dist/entrypoints/*.d.ts",
				"svelte": "./dist/entrypoints/*.js",
				"default": "./dist/entrypoints/*.js"
			}
		}
	},
	"scripts": {
		"api:contract:check": "node scripts/check-metadata-facts.mjs && node scripts/check-api-contract.mjs",
		"api:contract:update": "node scripts/check-metadata-facts.mjs && node scripts/check-api-contract.mjs --write",
		"prepare": "svelte-kit sync || echo ''",
		"metadata:facts:check": "node scripts/check-metadata-facts.mjs",
		"metadata:since:normalize": "node scripts/check-metadata-facts.mjs --write-unreleased",
		"metadata:since:materialize": "node scripts/check-metadata-facts.mjs --materialize-unreleased",
		"build": "svelte-package --input src",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:bundle": "node scripts/check-bundle.mjs"
	},
	"keywords": [
		"accessibility",
		"component-library",
		"css-in-js",
		"design-system",
		"svelte",
		"sveltekit",
		"typescript",
		"ui"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/zui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/zui"
	},
	"bugs": {
		"url": "https://github.com/kenconnet666/zadmin/issues"
	},
	"dependencies": {
		"@floating-ui/dom": "catalog:",
		"@internationalized/date": "catalog:",
		"@standard-schema/spec": "catalog:",
		"@types/estree": "catalog:",
		"csstype": "catalog:",
		"estree-walker": "catalog:",
		"magic-string": "catalog:",
		"runed": "catalog:",
		"stylis": "catalog:",
		"tabbable": "catalog:"
	},
	"peerDependencies": {
		"@lucide/svelte": "^1.37.0",
		"shiki": "^4.4.3",
		"svelte": ">=5.56.0 <6"
	},
	"peerDependenciesMeta": {
		"shiki": {
			"optional": true
		}
	},
	"devDependencies": {
		"@lucide/svelte": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/stylis": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"fast-check": "catalog:",
		"playwright": "catalog:",
		"shiki": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
