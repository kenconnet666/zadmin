{
	"name": "@zadmin/zui-taro",
	"version": "0.1.0",
	"description": "Typed ZUI components and ICSS primitives for Svelte-powered Taro mini programs.",
	"type": "module",
	"sideEffects": [
		"**/*.svelte"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./compiler": {
			"types": "./src/compiler/index.ts",
			"import": "./src/compiler/index.ts"
		},
		"./internal": {
			"types": "./src/runtime/internal.ts",
			"svelte": "./src/runtime/internal.ts",
			"import": "./src/runtime/internal.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js"
			},
			"./compiler": {
				"types": "./dist/compiler/index.d.ts",
				"import": "./dist/compiler/index.js"
			},
			"./internal": {
				"types": "./dist/runtime/internal.d.ts",
				"svelte": "./dist/runtime/internal.js",
				"import": "./dist/runtime/internal.js"
			}
		}
	},
	"scripts": {
		"build": "svelte-package --input src --output dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm --filter @zadmin/miniapp build && vitest --run",
		"test:coverage": "pnpm --filter @zadmin/miniapp build && vitest --run --coverage"
	},
	"keywords": [
		"svelte",
		"taro",
		"wechat",
		"mini-program",
		"components"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/zui-taro",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/zui-taro"
	},
	"bugs": {
		"url": "https://github.com/kenconnet666/zadmin/issues"
	},
	"dependencies": {
		"@zadmin/zui": "workspace:^"
	},
	"peerDependencies": {
		"@tarojs/components": "4.2.1",
		"@tarojs/runtime": "4.2.1",
		"svelte": "5.56.10"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@tarojs/components": "catalog:wechat",
		"@tarojs/runtime": "catalog:wechat",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@zadmin/miniapp": "workspace:^",
		"svelte": "https://pkg.svelte.dev/svelte/c/eb7532dd70fb11b36258347c44cf3910d244f987",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
