{
	"name": "@zadmin/webview",
	"version": "0.1.0",
	"description": "Typed Svelte and C# host framework for secure multi-target desktop WebViews.",
	"type": "module",
	"sideEffects": [
		"**/*.svelte"
	],
	"types": "./src/index.ts",
	"bin": {
		"webview": "./dist/build/cli.js"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"dotnet",
		"protocol",
		"targets",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./svelte": {
			"types": "./src/components/index.ts",
			"svelte": "./src/components/index.ts",
			"import": "./src/components/index.ts"
		},
		"./platform": {
			"types": "./src/platform/index.ts",
			"import": "./src/platform/index.ts"
		},
		"./build": {
			"types": "./src/build/index.ts",
			"import": "./src/build/index.ts"
		},
		"./testing": {
			"types": "./src/testing/index.ts",
			"import": "./src/testing/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./svelte": {
				"types": "./dist/components/index.d.ts",
				"svelte": "./dist/components/index.js",
				"import": "./dist/components/index.js"
			},
			"./platform": {
				"types": "./dist/platform/index.d.ts",
				"import": "./dist/platform/index.js"
			},
			"./build": {
				"types": "./dist/build/index.d.ts",
				"import": "./dist/build/index.js"
			},
			"./testing": {
				"types": "./dist/testing/index.d.ts",
				"import": "./dist/testing/index.js"
			}
		}
	},
	"scripts": {
		"build": "pnpm generate:check && svelte-package --input src --output dist",
		"check": "pnpm generate:check && svelte-check --tsconfig ./tsconfig.json",
		"dotnet:build": "dotnet build dotnet/ZAdmin.WebView.slnx --configuration Release",
		"dotnet:test": "node scripts/run-dotnet-tests.mjs",
		"generate": "node scripts/generate-protocol.mjs",
		"generate:check": "node scripts/generate-protocol.mjs --check",
		"test": "pnpm generate:check && vitest --run",
		"test:coverage": "pnpm generate:check && vitest --run --coverage"
	},
	"keywords": [
		"csharp",
		"desktop",
		"svelte",
		"webview",
		"webview2",
		"winui"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/ui/webview",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "ui/webview"
	},
	"peerDependencies": {
		"@zadmin/zui": "^0.1.0",
		"svelte": ">=5.56.0 <6"
	},
	"peerDependenciesMeta": {
		"@zadmin/zui": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@zadmin/zui": "workspace:^",
		"prettier": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
