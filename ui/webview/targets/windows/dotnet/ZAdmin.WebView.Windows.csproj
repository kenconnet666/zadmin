<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName Condition="'$(ProductName)' == ''">ZAdmin</AssemblyName>
    <AssemblyName Condition="'$(ProductName)' != ''">$(ProductName)</AssemblyName>
    <RootNamespace>ZAdmin.WebView.Windows</RootNamespace>
    <WebAssetsRoot Condition="'$(WebAssetsRoot)' == ''">$(MSBuildThisFileDirectory)..\assets</WebAssetsRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <ProjectReference Include="../../../dotnet/ZAdmin.WebView.Core/ZAdmin.WebView.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(WebAssetsRoot)\**\*" Link="Assets\Web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCompiledXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CompiledXaml Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledXaml)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
