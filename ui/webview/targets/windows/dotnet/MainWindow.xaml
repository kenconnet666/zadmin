<Window
    x:Class="ZAdmin.WebView.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ZAdmin">
    <Grid>
        <WebView2 x:Name="Browser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="FailurePanel" Background="#FF1F2937" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="WebView2 could not start" />
                <TextBlock x:Name="FailureMessage" Foreground="#FFD1D5DB" MaxWidth="640" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
