{
	"name": "@zadmin/sveltekit",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"svelte": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"import": "./src/lib/index.ts"
		},
		"./client": {
			"types": "./src/lib/client.ts",
			"svelte": "./src/lib/client.ts",
			"import": "./src/lib/client.ts"
		},
		"./zui": {
			"types": "./src/lib/zui/index.ts",
			"import": "./src/lib/zui/index.ts"
		},
		"./zui/client": {
			"types": "./src/lib/zui/client.ts",
			"import": "./src/lib/zui/client.ts"
		}
	},
	"publishConfig": {
		"svelte": "./dist/index.js",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"svelte": "./dist/client.js",
				"import": "./dist/client.js"
			},
			"./zui": {
				"types": "./dist/zui/index.d.ts",
				"import": "./dist/zui/index.js"
			},
			"./zui/client": {
				"types": "./dist/zui/client.d.ts",
				"import": "./dist/zui/client.js"
			}
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"build": "svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run tests",
		"test:coverage": "vitest --run --coverage tests",
		"test:zui-package": "node scripts/accept-zui-package.mjs"
	},
	"dependencies": {
		"@zadmin/core": "workspace:^",
		"@zadmin/zui": "workspace:^"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
