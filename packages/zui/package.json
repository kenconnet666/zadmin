{
	"name": "@zadmin/zui",
	"version": "0.1.0",
	"description": "Type-safe runtime CSS and foundational Svelte components with class-only compiler optimization.",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"svelte": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"import": "./src/lib/index.ts"
		},
		"./compiler": {
			"types": "./src/lib/compiler/preprocess.ts",
			"import": "./src/lib/compiler/preprocess.ts"
		},
		"./internal": {
			"types": "./src/lib/internal.ts",
			"svelte": "./src/lib/internal.ts",
			"import": "./src/lib/internal.ts"
		},
		"./sveltekit": {
			"types": "./src/lib/sveltekit/handle.ts",
			"import": "./src/lib/sveltekit/handle.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"svelte": "./dist/index.js",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js"
			},
			"./compiler": {
				"types": "./dist/compiler/preprocess.d.ts",
				"import": "./dist/compiler/preprocess.js"
			},
			"./internal": {
				"types": "./dist/internal.d.ts",
				"svelte": "./dist/internal.js",
				"import": "./dist/internal.js"
			},
			"./sveltekit": {
				"types": "./dist/sveltekit/handle.d.ts",
				"import": "./dist/sveltekit/handle.js"
			}
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"build": "svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"test:coverage": "vitest --run --coverage"
	},
	"keywords": [
		"css-in-js",
		"svelte",
		"sveltekit",
		"typescript",
		"ui"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/packages/zui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "packages/zui"
	},
	"bugs": {
		"url": "https://github.com/kenconnet666/zadmin/issues"
	},
	"dependencies": {
		"@zadmin/zui-core": "workspace:^",
		"@types/estree": "catalog:",
		"csstype": "catalog:",
		"estree-walker": "catalog:",
		"magic-string": "catalog:",
		"stylis": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.20.0",
		"svelte": ">=5.56.0 <6"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@types/stylis": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
