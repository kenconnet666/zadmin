{
	"name": "@zadmin/core",
	"version": "0.0.0",
	"type": "module",
	"bin": {
		"zadmin-plugin": "./src/cli.ts"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./plugin": {
			"types": "./src/plugin.ts",
			"import": "./src/plugin.ts"
		},
		"./di": {
			"types": "./src/di.ts",
			"import": "./src/di.ts"
		},
		"./vite": {
			"types": "./src/artifact/vite.ts",
			"import": "./src/artifact/vite.ts"
		}
	},
	"publishConfig": {
		"bin": {
			"zadmin-plugin": "./dist/cli.js"
		},
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./plugin": {
				"types": "./dist/plugin.d.ts",
				"import": "./dist/plugin.js"
			},
			"./di": {
				"types": "./dist/di.d.ts",
				"import": "./dist/di.js"
			},
			"./vite": {
				"types": "./dist/artifact/vite.d.ts",
				"import": "./dist/artifact/vite.js"
			}
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.test.json --noEmit",
		"test": "vitest --run tests"
	},
	"dependencies": {
		"semver": "catalog:",
		"tar": "catalog:"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/semver": "^7.7.1",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
