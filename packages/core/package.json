{
	"name": "@zadmin/core",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./plugin": {
			"types": "./src/plugin.ts",
			"import": "./src/plugin.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./plugin": {
				"types": "./dist/plugin.d.ts",
				"import": "./dist/plugin.js"
			}
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.test.json --noEmit",
		"test": "vitest --run tests"
	},
	"dependencies": {
		"semver": "catalog:"
	},
	"devDependencies": {
		"@types/semver": "^7.7.1",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
