{
	"name": "@zadmin/auth",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"svelte": "./src/lib/index.ts",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"import": "./src/lib/index.ts"
		},
		"./client": {
			"types": "./src/lib/client.ts",
			"svelte": "./src/lib/client.ts",
			"import": "./src/lib/client.ts"
		}
	},
	"publishConfig": {
		"svelte": "./dist/index.js",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"import": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"svelte": "./dist/client.js",
				"import": "./dist/client.js"
			}
		}
	},
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"build": "svelte-package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@zadmin/core": "workspace:^",
		"@zadmin/drizzle": "workspace:^",
		"@zadmin/postgres": "workspace:^",
		"@zadmin/redis": "workspace:^",
		"@zadmin/sveltekit": "workspace:^",
		"@zadmin/zui": "workspace:^"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	}
}
