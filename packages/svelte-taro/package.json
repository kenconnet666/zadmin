{
	"name": "@zadmin/svelte-taro",
	"version": "0.1.0",
	"description": "A typed Svelte 5 framework plugin, renderer, runtime, and platform layer for Taro.",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/plugin/index.cjs",
	"types": "./src/index.ts",
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js",
			"require": "./dist/plugin/index.cjs"
		},
		"./plugin": {
			"types": "./src/plugin/types.ts",
			"require": "./dist/plugin/index.cjs"
		},
		"./renderer": {
			"types": "./src/renderer/index.ts",
			"import": "./dist/renderer/index.js"
		},
		"./runtime": {
			"types": "./src/runtime/index.ts",
			"import": "./dist/runtime/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"main": "./dist/plugin/index.cjs",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"require": "./dist/plugin/index.cjs"
			},
			"./plugin": {
				"types": "./dist/plugin/types.d.ts",
				"require": "./dist/plugin/index.cjs"
			},
			"./renderer": {
				"types": "./dist/renderer/index.d.ts",
				"import": "./dist/renderer/index.js"
			},
			"./runtime": {
				"types": "./dist/runtime/index.d.ts",
				"import": "./dist/runtime/index.js"
			}
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.test.json --noEmit",
		"test": "pnpm build && vitest --run tests",
		"test:coverage": "pnpm build && vitest --run --coverage tests"
	},
	"keywords": [
		"svelte",
		"taro",
		"wechat",
		"mini-program",
		"custom-renderer"
	],
	"homepage": "https://github.com/kenconnet666/zadmin/tree/master/packages/svelte-taro",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kenconnet666/zadmin.git",
		"directory": "packages/svelte-taro"
	},
	"peerDependencies": {
		"@tarojs/runtime": "4.2.1",
		"@tarojs/service": "4.2.1",
		"@tarojs/shared": "4.2.1",
		"@tarojs/taro": "4.2.1",
		"svelte": "5.56.10"
	},
	"devDependencies": {
		"@tarojs/runtime": "catalog:wechat",
		"@tarojs/service": "catalog:wechat",
		"@tarojs/shared": "catalog:wechat",
		"@tarojs/taro": "catalog:wechat",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"svelte": "https://pkg.svelte.dev/svelte/c/eb7532dd70fb11b36258347c44cf3910d244f987",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
