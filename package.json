{
	"name": "zadmin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "pnpm dev:admin",
		"dev:admin": "pnpm --parallel --stream --filter @zadmin/admin --filter @zadmin/approval --filter @zadmin/erp --filter @zadmin/crm run dev",
		"dev:etl": "pnpm --filter @zadmin/etl-app dev",
		"dev:docs": "pnpm --filter @zadmin/docs dev",
		"dev:desktop": "pnpm --filter @zadmin/desktop webview:dev",
		"dev:wechat": "pnpm --filter @zadmin/wechat-app dev",
		"build:desktop": "pnpm --filter @zadmin/desktop webview:build",
		"build:wechat": "pnpm --filter @zadmin/wechat-app build",
		"check:desktop": "pnpm --filter @zadmin/desktop check",
		"check:wechat": "pnpm --filter @zadmin/wechat-app check",
		"test:desktop": "pnpm --filter @zadmin/desktop test",
		"test:wechat": "pnpm --filter @zadmin/wechat-app test",
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r --if-present check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present test"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
