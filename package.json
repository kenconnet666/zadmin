{
	"name": "zadmin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "pnpm dev:admin",
		"dev:admin": "pnpm --filter @zadmin/admin dev",
		"dev:etl": "pnpm --filter @zadmin/etl-app dev",
		"dev:docs": "pnpm --filter @zadmin/docs dev",
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r --if-present check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present test"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
