{
	"name": "zadmin",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "pnpm dev:admin",
		"dev:admin": "pnpm --parallel --stream --filter @zadmin/admin --filter @zadmin/approval --filter @zadmin/erp --filter @zadmin/crm run dev",
		"dev:etl": "pnpm --filter @zadmin/etl-app dev",
		"dev:docs": "pnpm --filter @zadmin/docs dev",
		"dev:desktop": "pnpm --filter @zadmin/desktop webview:dev",
		"dev:wechat": "pnpm --filter @zadmin/wechat-app dev",
		"build:desktop": "pnpm --filter @zadmin/desktop webview:build",
		"build:wechat": "pnpm --filter @zadmin/wechat-app build",
		"changeset": "changeset",
		"check:desktop": "pnpm --filter @zadmin/desktop check",
		"check:wechat": "pnpm --filter @zadmin/wechat-app check",
		"test:desktop": "pnpm --filter @zadmin/desktop test",
		"test:wechat": "pnpm --filter @zadmin/wechat-app test",
		"zui:artifacts:update": "pnpm --filter @zadmin/zui api:contract:update && pnpm --filter @zadmin/docs api:source:update && pnpm --filter @zadmin/docs api:catalog:update && pnpm --filter @zadmin/docs maturity:update && pnpm --filter @zadmin/docs stability:update && pnpm --filter @zadmin/docs support:update && pnpm --filter @zadmin/docs docs:versioned:update && pnpm release:readiness:update && pnpm --filter @zadmin/docs progress:update",
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r --if-present check",
		"lint": "prettier --check . && eslint .",
		"release:publish": "changeset publish",
		"release:readiness": "node scripts/check-release-readiness.mjs",
		"release:readiness:update": "node scripts/check-release-readiness.mjs --write",
		"release:coherence": "node scripts/check-release-coherence.mjs",
		"release:coherence:self-test": "node scripts/check-release-coherence.mjs --self-test",
		"release:pack:artifacts": "node scripts/pack-release-artifacts.mjs",
		"release:handoff:check": "node scripts/prepare-release-handoff.mjs",
		"release:handoff:self-test": "node scripts/prepare-release-handoff.mjs --self-test",
		"release:candidate:check": "node scripts/check-release-candidate.mjs",
		"release:candidate:self-test": "node scripts/check-release-candidate.mjs --self-test",
		"release:status": "changeset status",
		"release:version": "changeset version",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present test"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	}
}
